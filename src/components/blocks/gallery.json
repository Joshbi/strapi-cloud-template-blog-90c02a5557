{
  "collectionName": "components_blocks_galleries",
  "info": {
    "displayName": "Gallery"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "subHeading": {
      "type": "string"
    },
    "images": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": true,
      "required": true
    },
    "gridType": {
      "type": "enumeration",
      "enum": [
        "grid",
        "masonry",
        "masonry-auto"
      ],
      "default": "grid"
    },
    "mobileColumns": {
      "type": "enumeration",
      "enum": [
        "1",
        "2"
      ],
      "default": "1"
    },
    "desktopColumns": {
      "type": "enumeration",
      "enum": [
        "2",
        "3",
        "4",
        "5"
      ],
      "default": "3"
    },
    "gap": {
      "type": "enumeration",
      "enum": [
        "none",
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    "imageRound": {
      "type": "enumeration",
      "enum": [
        "none",
        "sm",
        "md",
        "lg",
        "full"
      ],
      "default": "none"
    },
    "configuration": {
      "type": "component",
      "repeatable": false,
      "component": "shared.configuration"
    }
  }
}
